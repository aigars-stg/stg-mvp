# Coming Soon Mode
# Set to 'true' to enable "coming soon" mode for production preview
# This will:
# - Show a "launching soon" banner on the homepage
# - Disable signup functionality (signup page shows coming soon message)
# - Hide signup links throughout the site
# - Disable CTAs on homepage (show "Coming Soon" buttons instead)
# - Keep signin functional for existing users
# Set to 'false' or leave empty for normal operation
NEXT_PUBLIC_COMING_SOON=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# BGG API Configuration
BGG_API_RATE_LIMIT_MS=1000
BGG_API_TOKEN=your_bgg_api_token

# Cloudflare Turnstile (CAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Cron Secret (for scheduled tasks)
CRON_SECRET=your_cron_secret

# Resend API (for emails)
RESEND_API_KEY=your_resend_api_key
