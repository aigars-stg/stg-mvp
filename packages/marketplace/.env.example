# Coming Soon Mode
# Set to 'true' to enable "coming soon" mode for production preview
# This will:
# - Show a "launching soon" banner on the homepage
# - Disable signup functionality (signup page shows coming soon message)
# - Hide signup links throughout the site
# - Disable CTAs on homepage (show "Coming Soon" buttons instead)
# - Keep signin functional for existing users
# Set to 'false' or leave empty for normal operation
NEXT_PUBLIC_COMING_SOON=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# BGG API Configuration
BGG_API_RATE_LIMIT_MS=1000
BGG_API_TOKEN=your_bgg_api_token

# Cloudflare Turnstile (CAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Cron Secret (for scheduled tasks)
CRON_SECRET=your_cron_secret

# Resend API (for emails)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=SecondTurn <noreply@secondturn.games>

# EveryPay (Payment Gateway via Swedbank)
# Demo: https://igw-demo.every-pay.com/api/v4
# Production: https://igw.every-pay.com/api/v4
EVERYPAY_API_USERNAME=your_everypay_api_username
EVERYPAY_API_SECRET=your_everypay_api_secret
EVERYPAY_API_URL=https://igw-demo.every-pay.com/api/v4
EVERYPAY_ACCOUNT_NAME=your_everypay_account_name

# Unisend API (Terminal-to-Terminal Shipping)
# Test environment: https://api-manosiuntostst.post.lt
# Production environment: https://api-manosiuntos.post.lt
UNISEND_API_URL=https://api-manosiuntostst.post.lt
UNISEND_USERNAME=your_unisend_username
UNISEND_PASSWORD=your_unisend_password

# Upstash Redis (rate limiting + caching)
# Get credentials from https://console.upstash.com
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Application URL
# Development: http://localhost:3001
# Production: https://secondturn.app
NEXT_PUBLIC_APP_URL=http://localhost:3001
